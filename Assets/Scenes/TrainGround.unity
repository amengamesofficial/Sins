  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0627\u06A9\u0646\u0648\u0646 \u0622\u0645\u062F\u0647 \u0627\u06CC \u0628\u0647
      \u0645\u062D\u06CC\u0637 \u062A\u0645\u0631\u06CC\u0646"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u062F\u0631 \u0627\u06CC\u0646\u062C\u0627 \u0628\u0627\u06CC\u062F \u06CC\u0627\u062F
      \u0628\u06AF\u06CC\u0631\u06CC \u062C\u0686\u0648\u0646\u0647 \u0645\u0628\u0627\u0631\u0632\u0647
      \u06A9\u0646\u06CC"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0628\u0639\u062F \u0627\u0632 \u0622\u0645\u0648\u0632\u0634 \u0631\u0627\u0647\u06CC
      \u0645\u0628\u0627\u0631\u0632\u0647 \u0628\u0627 \u062F\u0634\u0645\u0646\u0627\u0646\u062A
      \u062E\u0648\u0627\u0647\u06CC \u0634\u062F"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0628\u0647 \u06CC\u0627\u062F \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634
      \u06A9\u0647 \u062F\u0634\u0645\u0646\u0627\u0646\u062A \u062E\u06CC\u0644\u06CC
      \u0628\u06CC \u0631\u062D\u0645 \u0647\u0633\u062A\u0646\u062F"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0628\u0639\u062F \u0627\u0632 \u0634\u06A9\u0633\u062A \u062F\u0627\u062F\u0646
