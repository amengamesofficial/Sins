  dialogue:
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0622\u0647 ..."
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0628\u062F\u0646\u0645 ..."
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u067E\u0633 \u0647\u0646\u0648\u0632 \u0632\u0646\u062F\u0647 \u0627\u06CC"
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0645\u0646 \u06A9\u062C\u0627\u0645 !\u061F"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0628\u06CC\u0646 \u0645\u0631\u06AF \u0648 \u0632\u0646\u062F\u06AF\u06CC"
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0686\u0631\u0627 \u061F"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0627\u06CC\u0646\u0648 \u0627\u0632 \u062E\u0648\u062F\u062A \u0628\u067E\u0631\u0633"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u06AF\u0647 \u06A9\u0627\u0631 \u0632\u0634\u062A\u06CC \u0647\u0645 \u0645\u0648\u0646\u062F\u0647
      \u06A9\u0647 \u0646\u06A9\u0631\u062F\u0647 \u0628\u0627\u0634\u06CC !!!"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0648\u0627\u0642\u0639\u0627 \u062E\u062F\u0627 \u062E\u06CC\u0644\u06CC
      \u0645\u0647\u0631\u0628\u0648\u0646\u0647 \u06A9\u0647 \u0647\u0646\u0648\u0632
      \u0628\u0647\u062A \u0641\u0631\u0635\u062A \u062F\u0627\u062F\u0647"
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0628\u062F\u0646\u0645 ... \u062E\u06CC\u0644\u06CC \u0633\u0646\u06AF\u06CC\u0646\u0647 "
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0646\u0645\u06CC\u062A\u0648\u0646\u0645 \u062A\u06A9\u0648\u0646 \u0628\u062E\u0648\u0631\u0645"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0633\u0646\u06AF\u06CC\u0646\u06CC\u0647 \u06A9\u0627\u0631\u0627\u062A\u0647"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u062E\u06CC\u0644\u06CC \u0648\u0642\u062A \u0646\u062F\u0627\u0631\u06CC"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0645\u06CC\u062E\u0648\u0627\u06CC \u0632\u0646\u062F\u0647 \u0628\u0645\u0648\u0646\u06CC
      \u061F"
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0622\u0631\u0647 \u0645\u0639\u0644\u0648\u0645\u0647 \u06A9\u0647 \u0645\u06CC\u062E\u0648\u0627\u0645"
  - x: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    y: "\u0645\u0646 \u06A9\u0645\u06A9\u062A \u0645\u06CC\u06A9\u0646\u0645 \u0648\u0644\u06CC
      \u0647\u0645\u0647 \u0686\u06CC \u0628\u0647 \u062E\u0648\u062F\u062A \u0628\u0633\u062A\u06AF\u06CC
      \u062F\u0627\u0631\u0647"
  - x: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    y: "\u0645\u0646 ... \u0645\u0646 ... \u0645..."
