    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[0].x
      value: 
      objectReference: {fileID: 21300000, guid: d656beca817ee104fa04f0258b18b43e, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[0].y
      value: "\u0628\u0631\u0627\u06CC\u062A \u06A9\u0644\u06CC\u062F \u0627\u0648\u0631\u062F\u0647
        \u0627\u0645 \u062A\u0627 \u067E\u0627\u0647\u0627\u06CC\u062A \u0631\u0627
        \u0628\u0627 \u06A9\u0646\u0645"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[1].x
      value: 
      objectReference: {fileID: 21300000, guid: 516723c7fe900e844875a2fdcec47667, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[1].y
      value: "\u0639\u0634\u0642\u06CC\u06CC \u0639\u0634\u0642\u0642\u0642\u0642"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[2].x
      value: 
      objectReference: {fileID: 21300000, guid: 516723c7fe900e844875a2fdcec47667, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[2].y
      value: "\u0645\u06CC\u200C\u062F\u0648\u0646\u0645... \u0647\u0645\u0647\u200C\u0634
        \u062A\u0642\u0635\u06CC\u0631 \u062E\u0648\u062F\u0645\u0647... \u0648\u0644\u06CC...
        \u0645\u06AF\u0647 \u0645\u06CC\u0634\u0647 \u062F\u0648\u0628\u0627\u0631\u0647
        \u067E\u0627\u06A9 \u0634\u062F\u061F"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[3].x
      value: 
      objectReference: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[3].y
      value: "\u0647\u0631 \u0631\u0648\u062D\u06CC \u0634\u0627\u06CC\u0633\u062A\u0647\u200C\u06CC
        \u0628\u0627\u0632\u06AF\u0634\u062A \u0627\u0633\u062A... \u0627\u0645\u0627
        \u0631\u0627\u0647\u06CC \u06A9\u0647 \u067E\u06CC\u0634 \u0631\u0648 \u062F\u0627\u0631\u06CC\u060C
        \u0622\u0633\u0627\u0646 \u0646\u06CC\u0633\u062A. \u0628\u0628\u06CC\u0646...
        \u0686\u0647\u0627\u0631 \u062F\u0631\u060C \u067E\u06CC\u0634 \u0631\u0648\u06CC
        \u0645\u0627\u0633\u062A."
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[4].x
      value: 
      objectReference: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[4].y
      value: "\u067E\u0634\u062A \u0647\u0631 \u062F\u0631\u060C \u0622\u0632\u0645\u0648\u0646\u06CC
        \u0646\u0647\u0641\u062A\u0647\u200C\u0633\u062A. \u0627\u06AF\u0631 \u0627\u0632
        \u0622\u0646\u0647\u0627 \u0628\u06AF\u0630\u0631\u0645 \u0648 \u0622\u0646\u0686\u0647
        \u0628\u0627\u06CC\u062F \u0631\u0627 \u0628\u0647 \u062F\u0633\u062A \u0622\u0648\u0631\u0645\u060C
        \u06AF\u0631\u0647\u200C\u0627\u06CC \u0627\u0632 \u0632\u0646\u062C\u06CC\u0631\u0647\u0627\u06CC
        \u062A\u0648 \u0628\u0627\u0632 \u0645\u06CC\u200C\u0634\u0648\u062F"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[5].x
      value: 
      objectReference: {fileID: 21300000, guid: 516723c7fe900e844875a2fdcec47667, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[5].y
      value: "\u0627\u0645\u0627... \u0645\u0646 \u06A9\u0647 \u062F\u06CC\u06AF\u0647
        \u0646\u0645\u06CC\u200C\u062A\u0648\u0646\u0645... \u0645\u0646 \u062D\u062A\u06CC
        \u0646\u0645\u06CC\u200C\u062A\u0648\u0646\u0645 \u0631\u0648\u06CC \u067E\u0627
        \u0648\u0627\u06CC\u0633\u0645."
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[6].x
      value: 
      objectReference: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[6].y
      value: "\u062A\u0648 \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u0628\u0631\u0648\u06CC...
        \u0627\u06CC\u0646 \u0633\u0641\u0631 \u0631\u0627 \u0645\u0646 \u0628\u0647
        \u062C\u0627\u06CC \u062A\u0648 \u062E\u0648\u0627\u0647\u0645 \u0631\u0641\u062A.
        \u0627\u0645\u0627 \u0628\u0627\u06CC\u062F \u0686\u06CC\u0632\u06CC \u0631\u0627
        \u0628\u0647 \u0645\u0646 \u0628\u062F\u0647\u06CC..."
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[7].x
      value: 
      objectReference: {fileID: 21300000, guid: 516723c7fe900e844875a2fdcec47667, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[7].y
      value: "\u0686\u06CC... \u0686\u06CC \u0627\u0632 \u0645\u0646 \u0645\u06CC\u200C\u062E\u0648\u0627\u06CC\u061F"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[8].x
      value: 
      objectReference: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[8].y
      value: "\u0627\u0639\u062A\u0631\u0627\u0641. \u062D\u0642\u06CC\u0642\u062A.
        \u0627\u0632 \u0632\u0628\u0627\u0646 \u062E\u0648\u062F\u062A \u0628\u06AF\u0648
        \u06A9\u0647 \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u06CC \u067E\u0627\u06A9
        \u0634\u0648\u06CC"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[9].x
      value: 
      objectReference: {fileID: 21300000, guid: 516723c7fe900e844875a2fdcec47667, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[9].y
      value: "\u0645\u06CC\u200C\u062E\u0648\u0627\u0645... \u0627\u0632 \u0627\u06CC\u0646
        \u0647\u0645\u0647 \u0633\u0646\u06AF\u06CC\u0646\u06CC \u0631\u0647\u0627
        \u0628\u0634\u0645. \u0645\u06CC\u200C\u062E\u0648\u0627\u0645 \u0686\u0634\u0645\u0627\u0645
        \u062F\u0648\u0628\u0627\u0631\u0647 \u067E\u0627\u06A9 \u0628\u0628\u06CC\u0646\u0646...
        \u062F\u0633\u062A\u0627\u0645 \u062F\u0631\u0633\u062A \u06A9\u0627\u0631
        \u06A9\u0646\u0646... \u0648 \u0634\u06A9\u0645\u0645 \u0633\u0628\u06A9
        \u0628\u0634\u0647 \u0627\u0632 \u062D\u0631\u0635 \u0648 \u06AF\u0646\u0627\u0647.
        \u0645\u0646 \u0645\u06CC\u200C\u062E\u0648\u0627\u0645... \u067E\u0627\u06A9
        \u0628\u0634\u0645"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[10].x
      value: 
      objectReference: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[10].y
      value: "\u067E\u0633 \u0645\u0646 \u0631\u0627\u0647\u062A \u0645\u06CC\u200C\u0634\u0648\u0645.
        \u062A\u0648 \u062F\u0631 \u0627\u06CC\u0646\u062C\u0627 \u0628\u0645\u0627\u0646...
        \u0648 \u0645\u0646\u060C \u0627\u0632 \u0686\u0647\u0627\u0631 \u062F\u0631
        \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0645. \u0628\u0627
        \u0647\u0631 \u0628\u0627\u0632\u06AF\u0634\u062A\u060C \u0632\u0646\u062C\u06CC\u0631\u06CC
        \u0627\u0632 \u0631\u0648\u062D\u062A \u0628\u0627\u0632 \u0645\u06CC\u200C\u06A9\u0646\u0645...
        \u062A\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0628\u0631\u062E\u06CC\u0632\u06CC"
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[11].x
      value: 
      objectReference: {fileID: 21300000, guid: 516723c7fe900e844875a2fdcec47667, type: 3}
