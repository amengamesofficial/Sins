      propertyPath: dialogue.Array.data[15].y
      value: "\u0633\u067E\u0633 \u062F\u0633\u062A\u200C\u0647\u0627\u06CC\u0645\u060C
        \u062A\u0627 \u062F\u0631\u0633\u062A \u0628\u0633\u0627\u0632\u0646\u062F
        \u0648 \u0628\u0633\u0627\u0632\u0646\u062F."
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[16].x
