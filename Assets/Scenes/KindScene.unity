    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[6].y
      value: "\u0627\u06A9\u0646\u0648\u0646 \u0627\u0648 \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u0645..."
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[7].x
      value: 
      objectReference: {fileID: 21300000, guid: eb2009c0f6b1efc48ab7495738cfcfbf, type: 3}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[7].y
      value: "\u0633\u0627\u06CC\u0647\u200C\u0627\u06CC \u062E\u0645\u06CC\u062F\u0647
        \u0628\u0631 \u0632\u0645\u06CC\u0646\u060C \u0628\u0627 \u0686\u0634\u0645\u0627\u0646\u06CC
        \u067E\u0631 \u0627\u0632 \u0646\u06CC\u0627\u0632."
      objectReference: {fileID: 0}
    - target: {fileID: 3565787079631846269, guid: c29f186934e4e044cb1c2483ce3a641a, type: 3}
      propertyPath: dialogue.Array.data[8].x
