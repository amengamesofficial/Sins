<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/button.uss?fileID=7433441132597879392&amp;guid=8bbcc7a04fa7e294ca39a54aa21b6436&amp;type=3#button" />
    <ui:VisualElement name="Menu" class="continer" style="flex-grow: 1; -unity-background-image-tint-color: rgb(255, 255, 255); flex-direction: row-reverse; -unity-background-scale-mode: stretch-to-fill; justify-content: center; align-items: center; align-self: center; display: none; background-color: rgb(57, 62, 70);">
        <ui:Label tabindex="-1" text="Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" style="position: absolute; top: 30px; font-size: 60px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgb(223, 208, 184); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: 900px; border-left-color: rgb(34, 40, 49); border-right-color: rgb(34, 40, 49); border-top-color: rgb(34, 40, 49); border-bottom-color: rgb(34, 40, 49); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px;" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResumeButton" class="button buttons" style="background-image: url(&quot;project://database/Assets/UI/Play.png?fileID=21300000&amp;guid=80a05e250c3b40e47a16ac97c96349f8&amp;type=3#Play&quot;);" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="SettingsButton" class="buttons" style="white-space: nowrap; background-image: url(&quot;project://database/Assets/UI/Gear%201.png?fileID=21300000&amp;guid=0349ccd202e37534bb09ff72714beed5&amp;type=3#Gear 1&quot;);" />
        <ui:Button text="Choose Level" parse-escape-sequences="true" display-tooltip-when-elided="true" name="LevelChooser" class="buttons" style="-unity-text-align: middle-center; font-size: 18px; -unity-font-style: bold;" />
    </ui:VisualElement>
    <ui:VisualElement name="SettingsPanel" class="continer" style="flex-grow: 1; flex-direction: column; background-image: none; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; align-items: center; justify-content: flex-start; align-self: center; margin-top: 0; padding-top: 20px; width: 100%; height: 100%; display: none; background-color: rgb(57, 62, 70);">
        <ui:Label tabindex="-1" text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" style="position: relative; top: auto; font-size: 60px; -unity-font-style: bold; -unity-text-align: middle-center; background-color: rgb(223, 208, 184); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: 900px; border-left-color: rgb(34, 40, 49); border-right-color: rgb(34, 40, 49); border-top-color: rgb(34, 40, 49); border-bottom-color: rgb(34, 40, 49); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px;" />
        <ui:VisualElement name="SettingsItemContainer" style="flex-grow: 0; background-color: rgb(223, 208, 184); flex-direction: column; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: auto; height: auto; border-left-color: rgb(34, 40, 49); border-right-color: rgb(34, 40, 49); border-top-color: rgb(34, 40, 49); border-bottom-color: rgb(34, 40, 49); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; align-items: center; justify-content: flex-start; align-self: center; display: flex;">
            <ui:RadioButtonGroup label="FPS     :" value="-1" choices="30,60" tabindex="0" focusable="true" name="FPS" class="buttonRadio" style="background-color: rgba(223, 208, 184, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 5px; border-left-width: 0;" />
            <ui:RadioButtonGroup label="Graphics     :" value="-1" choices="Low,Medium,High" tabindex="0" focusable="true" name="Graphic" class="buttonRadio" style="background-color: rgba(223, 208, 184, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 5px; border-left-width: 0; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px;" />
            <ui:RadioButtonGroup label="Audio     :" value="-1" choices="Enable,Disable" tabindex="0" focusable="true" name="Audio" class="buttonRadio" style="background-color: rgba(223, 208, 184, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 5px; border-left-width: 0;" />
            <ui:Button text="Change UI Size" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ChangeUISizeButton" class="buttonRadio" style="-unity-font: url(&quot;project://database/Assets/UI/Fonts/Paeez.ttf?fileID=12800000&amp;guid=0ab711c49af4ab14dbad3bfe1f0d7211&amp;type=3#Paeez&quot;); background-color: rgb(148, 137, 121); width: 500px; height: 100px; padding-bottom: 5px; margin-bottom: 20px;" />
        </ui:VisualElement>
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackToMenuButton" class="buttons" style="background-image: url(&quot;project://database/Assets/UI/Back.png?fileID=21300000&amp;guid=1762fb6f3d714314fb6346de8fd22b24&amp;type=3#Back&quot;); align-self: center; justify-content: space-around; align-items: flex-start; flex-direction: row; flex-wrap: nowrap; -unity-text-align: lower-center; white-space: nowrap; text-overflow: clip; -unity-slice-scale: 1px; transform-origin: center; scale: 1 1; right: 1436px; bottom: 10px; position: absolute; left: auto; width: 90px; height: 90px;" />
    </ui:VisualElement>
    <ui:VisualElement name="ChangeUIButtonPanel" class="continer" style="flex-grow: 1; background-color: rgba(57, 62, 70, 0.4); -unity-text-align: middle-center; flex-direction: row-reverse; display: none;">
        <ui:Slider label="Slider" high-value="1.5" name="UIChanger" low-value="1" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Save" class="buttons" style="-unity-text-align: middle-center; font-size: 40px; -unity-font-style: bold; margin-right: 4px; background-image: url(&quot;project://database/Assets/UI/Back.png?fileID=21300000&amp;guid=1762fb6f3d714314fb6346de8fd22b24&amp;type=3#Back&quot;); left: 158px;" />
    </ui:VisualElement>
</ui:UXML>
